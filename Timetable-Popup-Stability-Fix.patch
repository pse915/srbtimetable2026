+def _weekly_dialog_finish(message):
+    """Show the completed write without rerunning a live Streamlit dialog.
+
+    Streamlit reruns the dialog fragment on its own while a widget is used.
+    Running an extra fragment rerun after changing Sheets/session state was
+    fragile: the original selected lesson no longer exists after a swap.
+    We render success immediately, then close via the normal full-app path.
+    """
+    st.session_state["weekly_dialog_result"] = str(message)
+    st.success(str(message))
+    st.caption("시간표가 갱신되었습니다. 팝업을 닫으면 최신 주간표를 확인할 수 있습니다.")
+    if st.button("✖ 닫기", key="dlg_result_close", width="stretch"):
+        _close_weekly_action_dialog()
 
 
